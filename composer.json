{
  "name": "larena/scheduler",
  "description": "Larena Scheduler: Shared system package for declarative schedules, triggers, missed-run policy, locks, queue dispatch and schedule observability across Larena.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rim Zabarov",
      "homepage": "https://github.com/zabarov",
      "role": "Author"
    }
  ],
  "require": {
    "ext-json": "*",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "larena/access": "dev-main",
    "larena/audit": "dev-main",
    "larena/queue": "dev-main",
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Larena\\Scheduler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larena\\Scheduler\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "laravel/framework": "^13.0",
    "phpstan/phpstan": "^2.0"
  },
  "repositories": [
    {"type": "path", "url": "../access", "options": {"symlink": true}},
    {"type": "path", "url": "../audit", "options": {"symlink": true}},
    {"type": "path", "url": "../queue", "options": {"symlink": true}},
    {"type": "path", "url": "../dataview", "options": {"symlink": true}},
    {"type": "path", "url": "../layout", "options": {"symlink": true}},
    {"type": "path", "url": "../ui", "options": {"symlink": true}}
  ],
  "scripts": {
    "test": [
      "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SchedulerContractTest.php",
      "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SchedulerFailsClosedTest.php",
      "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/ScheduleRecurrenceCalculatorTest.php",
      "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/SchedulerRuntimeTest.php"
    ],
    "test:unit": "@test",
    "lint": "php scripts/lint.php",
    "analyse": "php scripts/analyse.php",
    "validate:larena": "php scripts/validate-larena-package.php",
    "evidence:check": "php scripts/check-evidence.php",
    "scope:check": "php tools/larena-scope-check.php",
    "quality:gate": [
      "@validate:larena",
      "@lint",
      "@analyse",
      "@test",
      "@evidence:check",
      "@scope:check"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.3.31"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Larena\\Scheduler\\Providers\\SchedulerServiceProvider"]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
